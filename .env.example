# Plantbase — környezeti változók (másold .env-be: `cp .env.example .env`)
# A .env SOHA nem kerül a repóba (lásd .gitignore, konvenciok.md/security.md).

# --- Adatbázis (két kapcsolat, két jog — architektura.md 2. pont) ---
# READ-WRITE: Prisma ezzel viszi a sémát, migrációt, seedet.
# Host port 5434 (lásd docker-compose.yml — 5432/5433 más helyi projekt(ek) által foglalt).
DATABASE_URL="postgresql://plantbase:plantbase@localhost:5434/plantbase?schema=public"
# READ-ONLY: az agent runSql-je ezen fut, csak SELECT (NFR1).
DATABASE_URL_READONLY="postgresql://plantbase_ro:plantbase_ro@localhost:5434/plantbase?schema=public"

# --- Anthropic (a termék-agent, 2. fázistól; a RAG-tudásbázis HyDE/rerank/chunk-elemzés/
# grounded válaszadás lépései is ugyanezt a modellt és kulcsot használják) ---
ANTHROPIC_API_KEY="sk-ant-..."
# Aktuális, stabil Claude modell; költségérzékeny demóhoz (pl. RAG-pipeline) claude-haiku-4-5 ajánlott.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- OpenAI (kizárólag a RAG-tudásbázis embeddingjéhez — az Anthropic nem kínál embedding-modellt) ---
# Csak a `pnpm cli ingest-knowledge` parancshoz és a RAG-kereséshez (apps/api /api/rag/chat) szükséges.
OPENAI_API_KEY="sk-..."

# --- Ügyfélirányú chat (docs/final_hw/) ---
# Kill-switch: "false"-ra állítva a /api/customer/chat és /api/internal/escalations
# route-ok ténylegesen nem is regisztrálódnak (apps/api/src/main.ts).
CUSTOMER_CHAT_ENABLED="true"
# A belső eszkalációs nézet (GET/POST /api/internal/escalations...) ezt várja
# `Authorization: Bearer <token>` fejlécben — csak akkor kötelező, ha
# CUSTOMER_CHAT_ENABLED="true". Demóhoz bármilyen egyedi string megteszi.
INTERNAL_TOKEN="valassz-egy-sajat-tokent"
