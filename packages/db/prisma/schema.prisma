generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  latin_name        String
  category          String
  location          String
  price             Decimal
  sale_price        Decimal?
  stock             Int
  light             String
  watering          String
  difficulty        String
  current_height_cm Int
  max_height_cm     Int
  current_pot_cm    Int
  pet_safe          Boolean
  kid_safe          Boolean
  air_purifying     Boolean
  rating            Decimal
  reviews_count     Int
  description       String

  @@map("products")
}

model KnowledgeDocument {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  source         String
  category       String
  contentHash    String
  chunkCount     Int
  lastIngestedAt DateTime
  chunks         KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         Int               @id @default(autoincrement())
  documentId Int
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  heading    String?
  content    String
  embedding  Unsupported("vector(1536)")

  @@unique([documentId, chunkIndex])
  @@map("knowledge_chunks")
}

model Escalation {
  id              Int       @id @default(autoincrement())
  question        String
  contextSnapshot String
  reason          String
  status          String    @default("open")
  reply           String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@map("escalations")
}
